FROM python:3.12-alpine

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DJANGO_SETTINGS_MODULE=config.settings.dev

# En desarrollo se dejan las herramientas de build por si alguna dependencia de dev no tiene rueda
# para musl. tzdata: Alpine no trae zonas horarias y Django necesita America/Bogota.
RUN apk add --no-cache ffmpeg libpq libjpeg-turbo zlib tzdata \
    build-base libffi-dev postgresql-dev jpeg-dev zlib-dev

WORKDIR /app
COPY requirements/ requirements/
RUN pip install --no-cache-dir -r requirements/dev.txt

# El codigo se monta como volumen en docker-compose.dev.yml
COPY . .

EXPOSE 8000
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
