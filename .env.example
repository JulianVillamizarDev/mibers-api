# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Base de datos (Render Postgres en produccion) ---
DATABASE_URL=postgres://mibers:mibers@db:5432/mibers

# --- Archivos (/media) ---
MEDIA_ROOT=/app/media

# --- Cifrado en reposo AES-256 (RNF02) ---
# Generar: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=change-me

# --- WhatsApp Cloud API (numero de la agencia) ---
# fake = simula los envios (dev/pruebas); cloud = API real de Meta
WHATSAPP_BACKEND=fake
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_LANGUAGE=es
WHATSAPP_TEMPLATE_CLIENT_IMAGE=pieza_cliente_imagen
WHATSAPP_TEMPLATE_CLIENT_VIDEO=pieza_cliente_video
WHATSAPP_TEMPLATE_CLIENT_DOCUMENT=pieza_cliente_documento
WHATSAPP_TEMPLATE_ALERT=alerta_director
WHATSAPP_TEMPLATE_REMINDER=recordatorio_publicacion

# --- Publicacion ---
PUBLICATION_OVERDUE_MINUTES=30
